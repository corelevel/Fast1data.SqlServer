
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Publish Module",
			"type": "process",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-NonInteractive",
				"-File",
				"${workspaceFolder}/out/publish.ps1"
			],
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {
					"FAST1_TEST_MIGRATION_SQL_CONN_STR": "${env:FAST1_TEST_MIGRATION_SQL_CONN_STR}",
					"FAST1_TEST_ARCHIVING_SQL_CONN_STR": "${env:FAST1_TEST_ARCHIVING_SQL_CONN_STR}",
					"FAST1_TEST_AUDIT_SQL_CONN_STR": "${env:FAST1_TEST_AUDIT_SQL_CONN_STR}",
					"FAST1_TEST_AUDIT_FOLDER": "${env:FAST1_TEST_AUDIT_FOLDER}",
					"FAST1_TEST_AUDIT_SMB_USER": "${env:FAST1_TEST_AUDIT_SMB_USER}",
					"FAST1_TEST_AUDIT_SMB_PASSWORD": "${env:FAST1_TEST_AUDIT_SMB_PASSWORD}"
				}
			},
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"label": "Build Project",
			"type": "process",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-NonInteractive",
				"-File",
				"${workspaceFolder}/build/build.ps1"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"problemMatcher": []
		}
	]
}
